# Site blocks for the shared /srv/proxy/Caddyfile.
# The app and drop services must share the web Docker network.

# ── 7chan.3chan.kr : 결혼 알림 랜딩 (marriage announcement) ─────────────
7chan.3chan.kr {
	encode zstd gzip
	handle_path /drop/* {
		reverse_proxy drop-app:8080
	}
	handle {
		reverse_proxy married-app:3001
	}
}

# Legacy address: keep file-drop access; move announcement links to 7chan.
# Public redirects require the legacy hostname to retain a DNS record.
married.3chan.kr {
	encode zstd gzip
	handle_path /drop/* {
		reverse_proxy drop-app:8080
	}
	handle {
		redir https://7chan.3chan.kr{uri} 308
	}
}
